######################
#### DEPENDENCIES ####
######################
@import 'EXT:bootstrap_package/Configuration/TypoScript/setup.typoscript'
@import 'EXT:bootstrap_package/Configuration/TypoScript/Bootstrap5/setup.typoscript'

page {
  includeCSS {
    bootstrap-icons = EXT:apache_solr_for_typo3_sitepackage/Resources/Public/Fonts/bootstrap-icons.css
  }

  # Picks the Xdebug session destination for the next request; see Documentation/Xdebug-DBGp.md.
  # Kept out of concatenation and minification so it stays greppable in page source, and it
  # renders itself only on local development hosts.
  includeJSFooter {
    xdebugSessionSwitch = EXT:apache_solr_for_typo3_sitepackage/Resources/Public/JavaScript/XdebugSessionSwitch.js
    xdebugSessionSwitch {
      excludeFromConcatenation = 1
      disableCompression = 1
    }
  }
}

@import './TypoScript/IntroductionData/setup.typoscript'
@import './TypoScript/Solr/setup.typoscript'
@import './TypoScript/Form/setup.typoscript'

# Bugfix bootstrap_package "address" tag
# See: https://github.com/benjaminkott/bootstrap_package/commit/926733682291e5c0147cf263d530424ea7a47a9f#commitcomment-97499240
lib.parseFunc_RTE.externalBlocks.address < lib.parseFunc_RTE.externalBlocks.div
