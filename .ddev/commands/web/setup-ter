#!/bin/bash

## Description: Set up the TER/classic-mode variant of this site
## Usage: solr:setup:ter
## Example: "ddev solr:setup:ter"

set -euo pipefail

readonly TER_NAME="ter-${DDEV_PROJECT}"
readonly TER_HOST="${TER_NAME}.${DDEV_TLD}"
readonly TER_DOCROOT="${DDEV_APPROOT}/${DDEV_DOCROOT}.TER"
readonly NGINX_TEMPLATE='/etc/nginx/sites-enabled/nginx-site.conf'
# DDEV copies .ddev/nginx_full/*.conf into sites-enabled on start, so the vhost
# survives a restart. Every run regenerates it from the live nginx-site.conf,
# which is how changes DDEV makes to its own config reach the TER variant.
readonly NGINX_CONFIG="${DDEV_APPROOT}/.ddev/nginx_full/${TER_NAME}.conf"
readonly NGINX_LIVE="/etc/nginx/sites-enabled/${TER_NAME}.conf"
readonly PROBE_FILE='__setup-ter-docroot-probe.txt'

# Matched with a wildcard on purpose: spelled out, DDEV would find its own
# signature in this script and replace it.
readonly DDEV_MARKER='^#ddev.generated$'

function announceStep() {
  echo -e "\n== ${1}"
}

# Also from .ddev/nginx_full/, because ddev start would install the broken
# config again and nginx would not come up at all.
function discardGeneratedConfig() {
  rm -f "${NGINX_CONFIG}"
  sudo rm -f "${NGINX_LIVE}"
  >&2 echo -e " Removed the generated config, so nginx keeps serving the site DDEV generated."
}

function mustContain() {
  if ! grep -qF "${1}" "${NGINX_CONFIG}"; then
    >&2 echo -e "The generated ${NGINX_CONFIG} has no ${2}."
    >&2 echo -e " DDEVs nginx-site.conf changed, the adjustments in this command need an update."
    discardGeneratedConfig
    exit 31
  fi
}

function mustNotContain() {
  if grep -qF "${1}" "${NGINX_CONFIG}"; then
    >&2 echo -e "The generated ${NGINX_CONFIG} still has ${2}."
    >&2 echo -e " DDEVs nginx-site.conf changed, the adjustments in this command need an update."
    discardGeneratedConfig
    exit 32
  fi
}

function requireRoutedHostname() {
  if [[ ",${DDEV_HOSTNAME}," != *",${TER_HOST},"* ]]; then
    >&2 echo -e "${TER_HOST} is not routed to this project."
    >&2 echo -e " Routed: ${DDEV_HOSTNAME}"
    >&2 echo -e " Add \"${TER_NAME}\" to additional_hostnames in .ddev/config.yaml,"
    >&2 echo -e " then run \"ddev restart\" on the host and this command again."
    exit 30
  fi
}

function generateNginxConfig() {
  announceStep "Generate ${NGINX_CONFIG} from ${NGINX_TEMPLATE}"

  if [[ ! -f "${NGINX_TEMPLATE}" ]]; then
    >&2 echo -e "${NGINX_TEMPLATE} does not exist, so there is nothing to derive the TER config from."
    >&2 echo -e " This command needs the nginx-fpm webserver type."
    exit 33
  fi

  # Everything the TER variant needs differently from the site DDEV generated:
  # its own server_name instead of being the default server, its own document
  # root, and the DDEV_* fastcgi params PHP reads to tell the variants apart.
  sed \
    -e "s|${DDEV_MARKER}|# Generated by \"ddev solr:setup:ter\" from nginx-site.conf, regenerate rather than edit.\\n# Deliberately unmarked as DDEV generated, so that DDEV keeps it in place.|" \
    -e "/^# If you want to take over this file and customize it, remove the line above\$/d" \
    -e "/^# and ddev will respect it and won't overwrite the file\.\$/d" \
    -e "s|^\\( *\\)listen 80 default_server;\$|\\1server_name ${TER_HOST};\\n\\n\\1listen 80;|" \
    -e "s|^\\( *\\)listen 443 ssl default_server;\$|\\1listen 443 ssl;|" \
    -e "s|^\\( *\\)root ${DDEV_APPROOT}/${DDEV_DOCROOT};\$|\\1root ${TER_DOCROOT};|" \
    -e "s|^\\( *\\)fastcgi_param HTTPS \\\$fcgi_https;\$|&\\n\\1# Use proper ENV inside of TER variant\\n\\1fastcgi_param DDEV_PROJECT ${TER_NAME};\\n\\1fastcgi_param DDEV_TLD ${DDEV_TLD};|" \
    "${NGINX_TEMPLATE}" > "${NGINX_CONFIG}"

  # A substitution that silently matched nothing would leave the variant serving
  # DDEVs document root, which is exactly the bug this command exists to avoid.
  mustContain "server_name ${TER_HOST};" 'server_name'
  mustContain "root ${TER_DOCROOT};" 'document root'
  mustContain "fastcgi_param DDEV_PROJECT ${TER_NAME};" 'DDEV_PROJECT param'
  mustContain "fastcgi_param DDEV_TLD ${DDEV_TLD};" 'DDEV_TLD param'
  mustNotContain 'listen 80 default_server;' 'the default server on port 80'
  mustNotContain 'listen 443 ssl default_server;' 'the default server on port 443'
  if grep -qE "${DDEV_MARKER}" "${NGINX_CONFIG}"; then
    >&2 echo -e "The generated ${NGINX_CONFIG} carries DDEVs own marker, which lets DDEV overwrite it."
    discardGeneratedConfig
    exit 32
  fi

  echo "Wrote ${NGINX_CONFIG}"
}

function installNginxConfig() {
  announceStep 'Install the config and restart nginx'

  sudo cp "${NGINX_CONFIG}" "${NGINX_LIVE}"
  if ! sudo nginx -t; then
    >&2 echo -e "nginx rejected the generated config."
    discardGeneratedConfig
    exit 12
  fi

  supervisorctl restart nginx
}

function verifyNginxRouting() {
  announceStep "Verify that https://${TER_HOST}/ is served from ${TER_DOCROOT}"

  if [[ ! -d "${TER_DOCROOT}" ]]; then
    >&2 echo -e "${TER_DOCROOT} does not exist yet, so the routing can not be verified."
    return 0
  fi

  # Through the router, not against 127.0.0.1: the router terminates TLS and
  # forwards to port 80, so a server block reachable on 443 only looks healthy
  # to nginx -t and to a local request, while every browser gets the other site.
  echo "${TER_DOCROOT}" > "${TER_DOCROOT}/${PROBE_FILE}"
  local served=''
  for _ in 1 2 3 4 5; do
    served="$(curl -sk --max-time 5 "https://${TER_HOST}/${PROBE_FILE}" || true)"
    [[ "${served}" == "${TER_DOCROOT}" ]] && break
    sleep 1
  done
  rm -f "${TER_DOCROOT}/${PROBE_FILE}"

  if [[ "${served}" != "${TER_DOCROOT}" ]]; then
    >&2 echo -e "https://${TER_HOST}/ is not served from ${TER_DOCROOT}."
    >&2 echo -e " Serving instead: ${served:-nothing}"
    exit 35
  fi

  echo "OK, https://${TER_HOST}/ serves ${TER_DOCROOT}"
}

requireRoutedHostname
generateNginxConfig
installNginxConfig
verifyNginxRouting
